# Build stage
FROM golang:1.24-alpine AS builder

# Install git and ca-certificates (needed for go mod download)
RUN apk add --no-cache git ca-certificates

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/httpserver

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS requests
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1001 -S auth302 && \
    adduser -u 1001 -S auth302 -G auth302

# Set working directory
WORKDIR /app

# Copy the binary from builder stage
COPY --from=builder /app/main .

# Copy config file (if it exists)
COPY --from=builder /app/config.json ./config.json

# Change ownership to non-root user
RUN chown -R auth302:auth302 /app

# Switch to non-root user
USER auth302

# Expose port (will be overridden by config)
EXPOSE 8080

# Run the application
CMD ["./main"] 